input "type:touchpad" {
  events disabled_on_external_mouse
  accel_profile flat
  pointer_accel 0.1
  natural_scroll disabled
  scroll_factor 1.0
  scroll_method two_finger
  left_handed disabled
  tap enabled
  tap_button_map lrm
  drag enabled
  drag_lock disabled
  dwt disabled
  middle_emulation enabled
  click_method button_areas
}
