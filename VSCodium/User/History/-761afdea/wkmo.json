{
    "debug.terminal.clearBeforeReusing": true,
    "code-runner.clearPreviousOutput": true,

    "workbench.colorTheme": "Dark Rock",
    "catppuccin-noctis-icons.hidesExplorerArrows": false,
    "workbench.iconTheme": "lynx-pro-dark",
    "workbench.productIconTheme": "lynx-material-icons",

    "code-runner.runInTerminal": true,
    "code-runner.preserveFocus": false,

    "code-runner.executorMap": {
        "c": "gcc $fileName -o $fileNameWithoutExt -lraylib -lGL -lm -lpthread -ldl -lX11 && ./$fileNameWithoutExt"
    },

    "code-runner.saveAllFilesBeforeRun": true,

    "clangd.enable": true,
    "clangd.inlayHints.enable": false,

    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.inlayHints.enabled": false
}