{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,

    "modules-left": [
        "network",
        "battery",
        "cpu",
        "memory",
        "sway/workspaces"
    ],
    "modules-center": [
        "pulseaudio#speaker",
        "custom/void",
        "custom/void"
    ],
    "modules-right": [],

    // ---------- Custom void spacer (zero CPU) ----------
    "custom/void": {
        "format": " ",
        "tooltip": false
    },

    // ---------- Network (event-driven) ----------
    "network": {
        "interval": 0,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "",
        "on-click": "wezterm -e nmtui",
        "tooltip-format-disconnected": "No Internet Connection",
        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "{ifname}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
    },

    // ---------- CPU ----------
    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%",
        "tooltip": true
    },

    // ---------- Memory ----------
    "memory": {
        "interval": 2,
        "format": "󰍛 {}%",
        "tooltip": true
    },

    // ---------- Workspaces ----------
    "sway/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "focused": "󰊠",
            "default": "✖",
            "urgent": "✖",
            "empty": "✖"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        },
        "spacing": 0
    },

    // ---------- Pulseaudio ----------
    "pulseaudio#speaker": {
        "scroll-step": 10,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    // ---------- Battery (event-driven) ----------
    "battery": {
        "interval": 0,
        "states": {
            "good": 100,
            "ok": 70,
            "warning": 50,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
    }
}