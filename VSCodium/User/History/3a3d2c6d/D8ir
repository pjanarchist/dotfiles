# ~/.config/mako/config

font=monospace 10

# Wildberry theme
background-color=#1e141a
text-color=#ffe6f0
border-color=#d63384
border-size=2
border-radius=6

padding=10
margin=10
default-timeout=5000
max-visible=5
layer=top

# Position
anchor=bottom-left

# Urgency styles
[urgency=low]
background-color=#2e1a27
text-color=#9e8a94
border-color=#4a2e3e

[urgency=normal]
background-color=#7b3f5a
text-color=#d6b3c6
border-color=#7b3f5a

[urgency=high]
background-color=#1a0a12
text-color=#ff4081
border-color=#ff4081
default-timeout=0