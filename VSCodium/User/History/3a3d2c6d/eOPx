# ~/.config/mako/config

font=monospace 10

# Gruvbox dark theme
background-color=#282828
text-color=#ebdbb2
border-color=#d79921
border-size=2
border-radius=6

padding=10
margin=10
default-timeout=5000
max-visible=5
layer=top

# Position
anchor=bottom-left

# Urgency styles
[urgency=low]
background-color=#282828
text-color=#a89984
border-color=#458588

[urgency=normal]
background-color=#282828
text-color=#ebdbb2
border-color=#d79921

[urgency=high]
background-color=#cc241d
text-color=#fbf1c7
border-color=#fb4934
default-timeout=0