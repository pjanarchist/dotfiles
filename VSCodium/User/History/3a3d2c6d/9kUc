# ~/.config/mako/config
# Wildberry theme – colors only changed

sort=+time
layer=overlay
margin=10
padding=15
border-radius=10
font=sans-serif 11
max-visible=5
default-timeout=5000

background-color=#2e1a27
border-color=#d63384
text-color=#ffe6f0

width=400

format=<b>%s</b>\n<span color="#A8E26E">%b</span>