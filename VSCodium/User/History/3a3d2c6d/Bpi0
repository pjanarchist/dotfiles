# ~/.config/mako/config
# Wildberry theme with green body text

# General
sort=+time
layer=overlay
margin=10
padding=15
border-radius=10
font=sans-serif 11
max-visible=5
default-timeout=5000

# Colors
background-color=#2e1a27
border-color=#d63384
text-color=#ffffff

# Width / height
width=400
height=auto

# Icons (optional)
#icon-location=/usr/share/icons/...

# Format: summary (heading) is bold white, body is green
format=<b>%s</b>\n<span color="#A8E26E">%b</span>

# Actions
# You can add action buttons later if needed